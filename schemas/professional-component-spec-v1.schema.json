{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officecli.ai/schemas/professional-component-spec-v1.schema.json",
  "title": "OfficeCLI Professional ComponentSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "componentId", "instanceId", "title", "density", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "componentId": {
      "enum": [
        "kpi-strip", "actual-target-forecast", "growth-contribution-waterfall", "capacity-demand-gap",
        "option-comparison", "risk-probability-impact", "decision-request", "cost-of-inaction",
        "milestone-timeline", "owner-time-standard", "dependency-graph", "rag-status"
      ]
    },
    "instanceId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "density": { "enum": ["compact", "balanced", "spacious"] },
    "target": { "type": "string", "minLength": 1, "maxLength": 500 },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "fields"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] } }
        }
      }
    },
    "factRefs": { "$ref": "#/$defs/refs" },
    "claimRefs": { "$ref": "#/$defs/refs" },
    "decisionRefs": { "$ref": "#/$defs/refs" },
    "actionRefs": { "$ref": "#/$defs/refs" },
    "themeTokens": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 240 } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
