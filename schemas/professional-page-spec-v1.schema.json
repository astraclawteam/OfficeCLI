{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officecli.ai/schemas/professional-page-spec-v1.schema.json",
  "title": "OfficeCLI Professional PageSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "format", "title", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentId": { "$ref": "#/$defs/id" },
    "format": { "enum": ["docx", "xlsx", "pptx"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "brandTokens": { "type": "object", "additionalProperties": { "type": "string" } },
    "pages": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["pageId", "pageRole", "primaryClaim", "readerTakeaway", "readerAction", "density", "blocks"],
      "properties": {
        "pageId": { "$ref": "#/$defs/id" }, "pageRole": { "type": "string", "minLength": 1 },
        "primaryClaim": { "type": "string", "minLength": 1 }, "readerTakeaway": { "type": "string", "minLength": 1 },
        "readerAction": { "type": "string", "minLength": 1 }, "density": { "enum": ["compact", "balanced", "spacious"] },
        "blocks": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["blockId", "kind", "importance"],
      "properties": {
        "blockId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["narrative", "component", "chart", "decision", "action", "source", "image"] },
        "importance": { "enum": ["primary", "supporting", "context"] }, "title": { "type": "string" }, "text": { "type": "string" },
        "factRefs": { "$ref": "#/$defs/refs" }, "claimRefs": { "$ref": "#/$defs/refs" }, "decisionRefs": { "$ref": "#/$defs/refs" }, "actionRefs": { "$ref": "#/$defs/refs" },
        "component": { "$ref": "professional-component-spec-v1.schema.json" },
        "chart": { "$ref": "information-chart-spec-v1.schema.json" }
      }
    }
  }
}
