{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officecli.ai/schemas/diagram-spec-v1.schema.json",
  "title": "DiagramSpec v1",
  "description": "Format-neutral semantic diagram contract. It contains no OOXML and no layout coordinates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "diagramId", "type", "direction", "facts", "nodes", "edges"],
  "properties": {
    "schemaVersion": {"const": 1},
    "diagramId": {"$ref": "#/$defs/id"},
    "type": {"enum": ["flowchart", "mindmap", "relationship", "architecture", "sequence", "timeline"]},
    "title": {"type": "string", "maxLength": 240},
    "direction": {"enum": ["top-down", "left-right"]},
    "communication": {"$ref": "#/$defs/communication"},
    "facts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/fact"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 400, "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "communication": {
      "type": "object", "additionalProperties": false,
      "required": ["intentId", "representationChoiceId", "purpose", "audience", "desiredResponse", "coreMessage", "maxNodesPerDiagram"],
      "properties": {
        "intentId": {"$ref": "#/$defs/id"}, "representationChoiceId": {"$ref": "#/$defs/id"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500}, "audience": {"type": "string", "minLength": 1, "maxLength": 240},
        "desiredResponse": {"type": "string", "minLength": 1, "maxLength": 500}, "coreMessage": {"type": "string", "minLength": 1, "maxLength": 500},
        "maxNodesPerDiagram": {"type": "integer", "minimum": 3, "maximum": 24}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["factId", "sourceId", "locator", "summary", "confidence"],
      "properties": {
        "factId": {"$ref": "#/$defs/id"}, "sourceId": {"type": "string", "minLength": 1, "maxLength": 200},
        "locator": {"type": "string", "minLength": 1, "maxLength": 500}, "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "factRefs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 500},
        "shape": {"enum": ["process", "decision", "terminator", "circle", "hexagon", "parallelogram", "database", "subroutine"]},
        "factRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "factRefs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "maxLength": 500}, "dashed": {"type": "boolean", "default": false},
        "factRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
