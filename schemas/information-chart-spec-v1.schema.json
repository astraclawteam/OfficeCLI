{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officecli.ai/schemas/information-chart-spec-v1.schema.json",
  "title": "OfficeCLI Information ChartSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chartId", "chartType", "title", "items", "factRefs", "claimRefs", "axisPolicy", "axisReason"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chartId": { "$ref": "#/$defs/id" },
    "chartType": { "enum": ["annotated-trend", "actual-target-forecast", "waterfall", "supply-demand-gap", "dumbbell-comparison", "probability-impact-scatter", "scenario-comparison", "sensitivity-heatmap"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
    "target": { "type": "string", "minLength": 1, "maxLength": 500 },
    "items": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/item" } },
    "annotations": { "type": "array", "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["itemLabel", "text"], "properties": { "itemLabel": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1, "maxLength": 500 } } } },
    "factRefs": { "$ref": "#/$defs/refs" },
    "claimRefs": { "$ref": "#/$defs/refs" },
    "axisPolicy": { "enum": ["auto", "zero", "nonzero"] },
    "axisReason": { "type": "string", "maxLength": 500 },
    "themeTokens": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "refs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "item": {
      "type": "object", "additionalProperties": false, "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "actual": { "type": "number" }, "target": { "type": "number" }, "forecast": { "type": "number" }, "value": { "type": "number" },
        "contribution": { "type": "number" }, "capacity": { "type": "number" }, "demand": { "type": "number" },
        "low": { "type": "number" }, "high": { "type": "number" }, "probability": { "type": "number" }, "impact": { "type": "number" },
        "fields": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    }
  }
}
